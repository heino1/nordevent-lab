# INTSIDENT B - kirjeldus õppejõult.
#
# Uuri: ./lab.sh stats ; ./lab.sh logs ; ./lab.sh trace <tellimuse-id>

# ===== Arhitektuur ja marsruutimine
# tühi = eraldatud teenused; 'classic' = käivita ka NE-Classic
COMPOSE_PROFILES=
# kuhu gateway suunab kataloogi päringud
CATALOG_UPSTREAM=catalog:8000
# kuhu gateway suunab broneerimise päringud
BOOKING_UPSTREAM=booking:8000
# kaua gateway ootab teenuse vastust
GATEWAY_TIMEOUT_S=10

# ===== Kataloog
# konteinerkujundi silt
CATALOG_VERSION=1.0
# KOHUSTUSLIK - puudumisel teenus ei käivitu
CATALOG_DATA_VERSION=2026.10
# soovitud koopiate arv (ECS: desired count)
CATALOG_REPLICAS=1
# CPU piir ühe koopia kohta (ECS: task CPU)
CATALOG_CPUS=0.5
# mälupiir ühe koopia kohta
CATALOG_MEMORY=128M
# protsessoritöö ühe päringu kohta
CATALOG_WORK_UNITS=40000
# api | shared_db | none
CATALOG_AVAILABILITY_SOURCE=api
# kaua kataloog ootab broneerimise vastust
CATALOG_AVAILABILITY_TIMEOUT_MS=800

# ===== Broneerimine
# v1 | v2 - broneerimise sisemine andmeskeem
BOOKING_SCHEMA=v1
# on | off - korduspäringute ja topelt-callback'ide kaitse
IDEMPOTENCY=on
# kaua oodatakse PayBalticu vastust
PAY_TIMEOUT_MS=2000
# mitu korduskatset maksealgatusel
PAY_RETRIES=1
# fixed | exponential - korduste vaheline ooteaeg
PAY_BACKOFF=exponential
# kaua piletit hoitakse kinni makse ootel
RESERVATION_TTL_S=120
# async (järjekorra kaudu) | sync (otsekutse)
NOTIFY_MODE=sync
# sync-režiimis teavituse ajalimiit
NOTIFY_TIMEOUT_MS=2000
# on | off - transactional outbox
OUTBOX=off
# TÜHI = võti tuleb failist secrets/; täidetud = võti keskkonnamuutujas
BOOKING_PAYBALTIC_API_KEY=

# ===== Teavitus ja järjekord
# ühe e-kirja saatmise aeg
NOTIFY_LATENCY_MS=200
# mitu % saatmistest ebaõnnestub
NOTIFY_FAIL_PCT=30
# paralleelsete töötlejate arv
NOTIFY_WORKERS=2
# on | off - sama tellimuse kinnitust ei saadeta kaks korda
NOTIFY_DEDUP=on
# kaua vastu võetud sõnum on nähtamatu
QUEUE_VISIBILITY_S=20
# katseid enne surnud kirjade järjekorda (DLQ)
QUEUE_MAX_RECEIVES=5

# ===== PayBaltic - väline maksepartner (simulaator)
# maksealgatuse vastuseaeg
PAYBALTIC_LATENCY_MS=400
# vastuseaja kõikumine
PAYBALTIC_LATENCY_JITTER_MS=150
# mitu % algatustest vastab 503
PAYBALTIC_FAIL_PCT=0
# on = partneri täielik katkestus
PAYBALTIC_OUTAGE=off
# mitu % maksetest õnnestub
PAYBALTIC_SUCCESS_PCT=97
# kui kiiresti saabub maksetulemus (callback)
PAYBALTIC_CALLBACK_DELAY_MS=1500
# mitu % callback'e saadetakse topelt
PAYBALTIC_DUPLICATE_CALLBACK_PCT=0

# ===== Koormus (./lab.sh load)
# kataloogi päringuid sekundis tavaliselt
CATALOG_RPS_BASE=5
# kataloogi päringuid sekundis tipus
CATALOG_RPS_PEAK=60
# broneerimiskatseid sekundis tavaliselt
BOOKING_RPS_BASE=0.5
# broneerimiskatseid sekundis tipus
BOOKING_RPS_PEAK=5
# kaua külastaja vastust ootab
CLIENT_TIMEOUT_S=4
# on = ajalõpu järel vajutab külastaja uuesti
PANIC_RETRY=on
# on = korduskatse saadab sama Idempotency-Key
CLIENT_SENDS_KEY=on

# ===== NE-Classic
# NE-Classicu CPU piir (kataloog + broneerimine kokku)
CLASSIC_CPUS=1.0
# NE-Classicu jagatud töölõimede arv
CLASSIC_WORKERS=16

